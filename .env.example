# =====================================================================
# KIT-PULSE : modele de configuration (VERSIONNE). Aucun secret ici.
# Copie locale : npm run setup   (cree .env, ignore par Git)
# Nouvelle variable = Daniel l'ajoute ici, jamais une autre personne.
# =====================================================================
NODE_ENV=development
APP_TIMEZONE=Africa/Bujumbura

# --- API ---
API_HOST=127.0.0.1
API_PORT=4000

# --- Base (SQLite). Chaque poste a son fichier local, genere a l'identique. ---
DATABASE_FILE=./data/kit-pulse.db

# --- Sessions ---
SESSION_TTL_HOURS=12

# --- RESEAUX KIT-HUB ------------------------------------------------
# !!! A REMPLIR : MAC REELLES NON FOURNIES. Lancer "npm run agent:scan" sur place.
# Liste separee par des virgules, format aa:bb:cc:dd:ee:ff.
# GATEWAY = MAC du ROUTEUR (passerelle). BSSID = MAC radio Wi-Fi (une par bande/repeteur).
# Vide = aucun pointage possible sur ce reseau (refus par defaut).
KITHUB_NET1_SSID=KIT-HUB_Starlink
KITHUB_NET1_GATEWAY_MACS=
KITHUB_NET1_BSSIDS=
KITHUB_NET2_SSID=Kit-Hub3
KITHUB_NET2_GATEWAY_MACS=
KITHUB_NET2_BSSIDS=
# gateway : MAC du routeur obligatoire (le SSID est aussi compare s'il est lisible)
# strict  : MAC du routeur + SSID + BSSID, tous du meme reseau
NETWORK_CHECK_MODE=gateway

# --- Agent local (poste de travail) ---
AGENT_PORT=47820
AGENT_SERVER_URL=http://127.0.0.1:4000
AGENT_DATA_DIR=./.agent-data
# Origines autorisees en plus de l'agent (developpement seulement)
AGENT_EXTRA_ORIGINS=http://127.0.0.1:5173

# --- DEVELOPPEMENT SEULEMENT (refuses si NODE_ENV=production) ---
# Permet de developper hors de KIT-HUB : reseau SIMULE, marque comme tel en base.
AGENT_SIMULATE_NETWORK=true
ALLOW_SIMULATED_NETWORK=true
DEV_AUTO_APPROVE_DEVICES=true
